{
  "info": {
    "_postman_id": "8a2f45f2-2a2b-4d66-9b1c-4c22a9d57f01",
    "name": "Farmacia Galeno API - Componente 3",
    "description": "Pruebas de login, CRUD, filtros, JWT y Problem Details. El login guarda token automáticamente.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api/v1"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "productId",
      "value": "1"
    },
    {
      "key": "loginEmail",
      "value": "admin@galeno.local"
    },
    {
      "key": "loginPassword",
      "value": "cambiar123"
    }
  ],
  "item": [
    {
      "name": "Health (sin token)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "Autenticación",
      "item": [
        {
          "name": "Login - sustituir correo y contraseña por un usuario real",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) { const body = pm.response.json(); pm.collectionVariables.set('token', body.token); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{loginEmail}}\",\n  \"password\": \"{{loginPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/auth/login"
          }
        }
      ]
    },
    {
      "name": "Productos",
      "item": [
        {
          "name": "Listar productos (caché)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/productos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "productos"
              ]
            }
          }
        },
        {
          "name": "Filtrar productos por texto",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/productos?q=acetaminofen&estado=true",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "productos"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "acetaminofen"
                },
                {
                  "key": "estado",
                  "value": "true"
                }
              ]
            }
          }
        },
        {
          "name": "Consultar producto por ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/productos/{{productId}}"
          }
        },
        {
          "name": "Crear producto",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Producto de prueba API\",\n  \"descripcion\": \"Registro creado desde Postman\",\n  \"precio\": 12.5,\n  \"stock\": 5,\n  \"categoria_id\": 1,\n  \"estado\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/productos"
          }
        },
        {
          "name": "Actualizar producto por ID",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Producto actualizado API\",\n  \"descripcion\": \"Actualizado desde Postman\",\n  \"precio\": 13.75,\n  \"stock\": 8,\n  \"categoria_id\": 1,\n  \"estado\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/productos/{{productId}}"
          }
        },
        {
          "name": "Eliminar producto por ID (irreversible)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/productos/{{productId}}"
          }
        }
      ]
    }
  ]
}