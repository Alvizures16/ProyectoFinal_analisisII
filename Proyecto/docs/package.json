{
  "name": "farmacia-galeno-api",
  "version": "1.0.0",
  "description": "Componente 3 API-First: API REST de Farmacia Galeno con MySQL, OpenAPI, Problem Details y BDD",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test tests/*.test.js",
    "frontend": "node frontend/server.js",
    "check-db": "node -e \"require('./src/config/db').checkDatabase().then(x=>{console.log(x);process.exit(0)}).catch(e=>{console.error(e.message);process.exit(1)})\""
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.14.0"
  },
  "devDependencies": {
    "supertest": "^7.1.0"
  }
}
